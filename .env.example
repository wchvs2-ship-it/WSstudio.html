# Configuração local; copie para .env, que não é versionado.
PORT=3000
HOST=0.0.0.0
DATA_DIR=.data
ADMIN_USERNAME=william
# O cadastro seguro da senha é feito por npm run admin:setup.
# Em hospedagem, ADMIN_PASSWORD_HASH pode ser definido nas configurações privadas.
# A origem pública permitida faz parte do CORS da API de pedidos.
ALLOWED_ORIGINS=https://wchvs2-ship-it.github.io
# Configure TRUST_PROXY=1 apenas quando houver um proxy reverso confiável.
TRUST_PROXY=0
