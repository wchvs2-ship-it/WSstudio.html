{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wsstudio-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ADMIN_USERNAME": "william",
    "ALLOWED_ORIGINS": "https://wchvs2-ship-it.github.io"
  },
  "durable_objects": {
    "bindings": [
      { "name": "STUDIO_API", "class_name": "StudioApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StudioApi"] }
  ]
}
